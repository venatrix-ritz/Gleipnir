#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later (derived from Armada scripts; see LICENSES/GPL-2.0.txt)
# Adapted from MgeeeeK/thor-armada (Mragank Shekhar), system_files/usr/libexec/armada/thor-charge-limit,
# commits a70010a + 7e17352. Kept: the 80 %/77 % hysteresis idea and the clamp-through-the-current-limit approach.
# Rewritten here for safety: see "Safety design" below. The fork ships Armada's LICENSE.md (GPL-2.0-or-later).
#
# Gleipnir: the 80 % battery ceiling for the AYN Thor (a Decky plugin; this is its root daemon).
#
# How it limits charging: the Thor's firmware ignores the standard charge_control_end_threshold (observed: it reads
# back 0). Armada's kernel patch 0903 instead exposes the battery manager's charge current limit as
# constant_charge_current; its commit message says writing 0 stops battery charging while the charger keeps powering
# the system. AYN's own Android "Stop at 80 %" writes a different node (/sys/class/qcom-battery/limit_capacity_charge,
# Android kernel only; it does not exist on Armada). So this is NOT a method known to work on the Thor: the daemon
# will not touch charging until the test below has proved it on this very kernel.
#
# Safety design:
#   1. Monitor-only until verified. Without a valid marker the daemon only logs. The marker is written by
#      `gleipnir --test --run` after a measured pass (charging stops while clamped AND resumes after release),
#      and is bound to the node, the clamp value and the running kernel, so a kernel update disarms it.
#   2. Restores on every exit path (TERM, INT, EXIT, error); the unit's ExecStopPost runs --restore for SIGKILL/crash.
#      A leftover clamp found at start is undone first, whether or not the daemon is armed.
#   3. Puts back exactly the value it found (the firmware changes it itself: 9000000 at 73 %, 4680000 at 96 %).
#   4. Every write is read back. Three failures in a row: release, log an error, exit 78.
#   5. Watchdog: if charging continues at more than 200 mA two minutes into a clamp, the limit has no effect: it
#      releases, deletes the marker and exits 78 so the failure is visible in `systemctl status`.
#   6. Releases when unplugged, at or below 77 %, or when the verification stops being valid; clamps at most once
#      every GLEIPNIR_MIN_HOLD_S (120 s) so it cannot flap.
#   7. Logs every decision to the journal (`journalctl -t gleipnir`) with a full battery snapshot, plus a
#      heartbeat every 10 minutes.
#
# Usage:  gleipnir                 run the daemon (what the systemd unit does)
#         gleipnir --status [--json]   read-only report
#         gleipnir --test          show the test plan (nothing is written)
#         gleipnir --test --run    the supervised test; needs root, charger plugged in, battery 10-90 %
#         gleipnir --restore       undo a leftover clamp (used by the unit's ExecStopPost)
#         gleipnir --set-sleep-floor N   the sleep setting (root): 0 every sleep, 70 from 70 %, 101 never
#         gleipnir --pre-sleep     clamp just before suspend (gleipnir-sleep.service); --post-sleep releases it if the daemon is not running
# Exit codes: 0 clean, 3 no limit node, 4 test preconditions not met, 5 test failed, 78 unsupported/ineffective.
set -uo pipefail
export LC_ALL=C

PS="${GLEIPNIR_PS_BASE:-/sys/class/power_supply}"
B="$PS/battery"
U="$PS/qcom-battmgr-usb"
STATE_DIR="${GLEIPNIR_STATE_DIR:-/var/lib/gleipnir}"
MARKER="$STATE_DIR/verified"
KERNEL="${GLEIPNIR_KERNEL:-$(uname -r)}"
TARGET=80
RELEASE_AT=77
CLAMP_DETECT=1000                    # a limit at or below this is ours (the firmware never reports this little)
POLL_S="${GLEIPNIR_POLL_S:-30}"
SETTLE_S="${GLEIPNIR_SETTLE_S:-120}"
MIN_HOLD_S="${GLEIPNIR_MIN_HOLD_S:-120}"
HEARTBEAT_S="${GLEIPNIR_HEARTBEAT_S:-600}"
WATCH_UA=200000                      # charging above this while clamped means the clamp is not working
BAD_LIMIT=3
APPLY_WAIT_S="${GLEIPNIR_APPLY_WAIT_S:-120}"   # how long a write may take to show in the node (about 60 s was seen on the Thor)
HOLD_S="${GLEIPNIR_HOLD_S:-20}"                # a restored node must keep reading released this long before the restore counts
WAIT_STEP_DS="${GLEIPNIR_WAIT_STEP_DS:-10}"    # poll step while waiting, in tenths of a second
SLEEP_FLOOR_FILE="$STATE_DIR/sleep-floor"      # the setting: clamp just before a native sleep from this charge up (any charger state)
SLEEP_FLOOR_DEFAULT="${GLEIPNIR_SLEEP_CLAMP_FROM:-0}"   # 0 = every sleep (the cap always holds, no charging asleep); 70 = from 70 % up; 101 = never
SLEEP_APPLY_WAIT_S="${GLEIPNIR_SLEEP_APPLY_WAIT_S:-10}"   # the pre-sleep hook may not hold up a suspend for long
SLEEP_FILE="$STATE_DIR/sleep-clamp"            # written by --pre-sleep BEFORE the clamp, so the daemon takes the clamp over instead of undoing it
SYSTEMCTL="${GLEIPNIR_SYSTEMCTL:-systemctl}"
DEVICE_ENV="${GLEIPNIR_DEVICE_ENV:-/usr/libexec/armada/device-env}"

# --- helpers ---------------------------------------------------------------------------------------------------
rd()  { cat "$1" 2>/dev/null || echo "?"; }
num() { case "${1:-}" in ''|*[!0-9-]*) echo 0 ;; *) echo "$1" ;; esac; }
abs() { local v; v=$(num "${1:-0}"); echo "${v#-}"; }
log() {
    local lvl=$1; shift
    if [ -n "${GLEIPNIR_NO_SYSLOG:-}" ]; then echo "gleipnir[$lvl]: $*" >&2   # tests: keep fake events out of the real journal
    else logger -t gleipnir -p "daemon.$lvl" -- "$*" 2>/dev/null || echo "gleipnir[$lvl]: $*" >&2; fi
    if [ -n "${GLEIPNIR_LOG_FILE:-}" ]; then echo "[$lvl] $*" >> "$GLEIPNIR_LOG_FILE"; fi
    return 0
}
snap() {
    printf 'cap=%s%% status=%s usb=%s current=%suA voltage=%suV temp=%s health=%s limit=%s' \
        "$(rd "$B/capacity")" "$(rd "$B/status")" "$(rd "$U/online")" "$(rd "$B/current_now")" \
        "$(rd "$B/voltage_now")" "$(rd "$B/temp")" "$(rd "$B/health")" "$(rd "$LIM")"
}

# --- which limit node does this kernel have --------------------------------------------------------------------
LIM=""; MAX=""; CLAMP_VAL=""; KIND=""
if [ -e "$B/charge_control_limit" ]; then            # MgeeeeK's patched qcom_battmgr
    LIM="$B/charge_control_limit"; MAX="$B/charge_control_limit_max"; CLAMP_VAL=1000; KIND="fork charge_control_limit"
elif [ -e "$B/constant_charge_current" ]; then       # stock Armada, kernel patch 0903
    LIM="$B/constant_charge_current"; MAX="$B/constant_charge_current_max"; CLAMP_VAL=0; KIND="Armada constant_charge_current"
fi
maxv=$(num "$(rd "$MAX")"); [ "$maxv" -gt "$CLAMP_DETECT" ] || maxv=9000000
is_clamped() { [ "$(num "${1:-}")" -le "$CLAMP_DETECT" ]; }

FAILS=0
# --- begin settle (tests/run-tests.sh runs this block against a node that shows writes late) ---------------------
# The limit node is slow. Observed on the Thor on 2026-10-08: right after the test wrote the clamp the node still read
# the old value, and about a minute later it read the clamp and charging had stopped. A write is therefore judged by
# waiting for the node to show it, up to APPLY_WAIT_S, and a restore only counts once the node has kept showing the
# released value for HOLD_S, because a clamp written earlier can still be on its way.
step_sleep() { sleep "$((WAIT_STEP_DS / 10)).$((WAIT_STEP_DS % 10))"; }
steps_for() { echo $(($1 * 10 / WAIT_STEP_DS)); }   # seconds -> poll steps
node_write() { echo "$1" > "$LIM" 2>/dev/null; }
value_ok() {   # value_ok VALUE exact|released READBACK ; "released" accepts any readback above CLAMP_DETECT,
               # because the firmware may adjust its own value right after
    if [ "$2" = exact ]; then [ "$3" = "$1" ]; else [ "$(num "$3")" -gt "$CLAMP_DETECT" ]; fi
}
wait_for() {   # wait_for VALUE exact|released : poll the node until it shows the value or APPLY_WAIT_S has passed; RB = last readback
    local i=0 max; max=$(steps_for "$APPLY_WAIT_S")
    while :; do
        RB=$(rd "$LIM")
        value_ok "$1" "$2" "$RB" && return 0
        [ "$i" -ge "$max" ] && return 1
        i=$((i + 1)); step_sleep
    done
}
write_limit() {   # write_limit VALUE exact|released : write, wait for the node to show it, count failures
    node_write "$1"
    if wait_for "$1" "$2"; then FAILS=0; return 0; fi
    FAILS=$((FAILS + 1)); log err "write of $1 to $LIM did not show in ${APPLY_WAIT_S}s (readback '$RB'; failure $FAILS in a row)"
    return 1
}
ensure_released() {   # ensure_released TARGET : put the limit back and see that it STAYS back; up to 3 rounds
    local round=0 i max; max=$(steps_for "$HOLD_S")
    while [ "$round" -lt 3 ]; do
        round=$((round + 1))
        write_limit "$1" released || continue
        i=0
        while [ "$i" -lt "$max" ]; do
            step_sleep; i=$((i + 1))
            is_clamped "$(num "$(rd "$LIM")")" && continue 2   # a clamp landed after our write: write again
        done
        return 0
    done
    return 1
}
# --- end settle -------------------------------------------------------------------------------------------------

sleep_floor() {   # the saved setting if it is a number from 0 to 101, else the default
    local v; v=$(head -c 8 "$SLEEP_FLOOR_FILE" 2>/dev/null | tr -d ' \n')
    case "$v" in ''|*[!0-9]*) echo "$SLEEP_FLOOR_DEFAULT" ;; *) if [ "$v" -le 101 ]; then echo "$v"; else echo "$SLEEP_FLOOR_DEFAULT"; fi ;; esac
}
sleep_mode() {    # Armada's sleep type: s2idle (native, freezes this daemon) or fake (the daemon keeps running); set in Armada Control
    local m; m=$("$DEVICE_ENV" 2>/dev/null | sed -n 's/^ARMADA_SUSPEND_MODE=//p' | head -1 | tr -d "'\"")
    echo "${m:-unknown}"
}

marker_ok() {   # sets MARKER_WHY
    MARKER_WHY=""
    [ -r "$MARKER" ] || { MARKER_WHY="not verified: no marker at $MARKER (run: sudo gleipnir --test --run)"; return 1; }
    local n v k
    n=$(sed -n 's/^node=//p' "$MARKER" | head -1); v=$(sed -n 's/^value=//p' "$MARKER" | head -1); k=$(sed -n 's/^kernel=//p' "$MARKER" | head -1)
    if [ "$n" != "$LIM" ] || [ "$v" != "$CLAMP_VAL" ] || [ "$k" != "$KERNEL" ]; then
        MARKER_WHY="verification is for node '$n' value '$v' kernel '$k', this system is '$LIM' '$CLAMP_VAL' '$KERNEL'; re-run the test"
        return 1
    fi
    return 0
}

# --- modes that need no daemon state ---------------------------------------------------------------------------
if [ "${1:-}" = --set-sleep-floor ]; then   # gleipnir --set-sleep-floor N : 0 every sleep, 70 from 70 %, 101 never
    case "${2:-}" in ''|*[!0-9]*) echo "usage: gleipnir --set-sleep-floor N (0 to 101)" >&2; exit 1 ;; esac
    if [ "$2" -gt 101 ]; then echo "usage: gleipnir --set-sleep-floor N (0 to 101)" >&2; exit 1; fi
    if [ "$(id -u)" != 0 ] && [ "${GLEIPNIR_ALLOW_NONROOT:-0}" != 1 ]; then echo "Run as root: sudo $0 --set-sleep-floor $2" >&2; exit 4; fi
    mkdir -p "$STATE_DIR" && echo "$2" > "$SLEEP_FLOOR_FILE.tmp" && mv "$SLEEP_FLOOR_FILE.tmp" "$SLEEP_FLOOR_FILE" || { echo "could not write $SLEEP_FLOOR_FILE" >&2; exit 4; }
    log info "sleep setting changed: clamp before a native sleep from ${2}% up"
    exit 0
fi
mode=daemon; run=0; json=0
for a in "$@"; do
    case "$a" in
        --status) mode=status ;; --test) mode=test ;; --restore) mode=restore ;; --pre-sleep) mode=presleep ;; --post-sleep) mode=postsleep ;; --run) run=1 ;; --json) json=1 ;;
        *) echo "unknown option $a" >&2; exit 1 ;;
    esac
done
if [ -z "$LIM" ]; then
    echo "gleipnir: no charge_control_limit or constant_charge_current under $B; this kernel has no usable limit." >&2
    log err "no usable charge limit node on kernel $KERNEL; exiting"
    [ "$mode" = daemon ] && exit 78; exit 3
fi

if [ "$mode" = restore ]; then
    cur=$(num "$(rd "$LIM")")
    if is_clamped "$cur" && [ "$cur" != "$maxv" ]; then
        if ensure_released "$maxv"; then log warning "--restore: found leftover clamp ($cur), restored $maxv"; else log err "--restore could NOT restore $maxv to $LIM"; fi
    fi
    exit 0
fi

# The kernel freezes the daemon in a native (s2idle) sleep, so a battery below the cap keeps charging past it while the Thor sleeps
# (2026-10-08: slept at 78 % on a charger, woke at 88 %). A clamp the firmware already holds survives the sleep, so the
# sleep unit writes one just before the freeze. The daemon, still running until then, must see it as ours: the file goes first.
if [ "$mode" = presleep ]; then
    marker_ok || { log info "pre-sleep: not armed ($MARKER_WHY); nothing done"; exit 0; }
    cap=$(num "$(rd "$B/capacity")"); cur=$(num "$(rd "$LIM")")
    floor=$(sleep_floor)
    if [ "$cap" -lt "$floor" ]; then log info "pre-sleep: ${cap}% is below the sleep setting (${floor}%); no clamp; $(snap)"; exit 0; fi
    if is_clamped "$cur"; then log info "pre-sleep: already clamped; $(snap)"; exit 0; fi
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf 'saved=%s
at=%s
' "$cur" "$(date +%s)" > "$SLEEP_FILE.tmp" && mv "$SLEEP_FILE.tmp" "$SLEEP_FILE"
    APPLY_WAIT_S=$SLEEP_APPLY_WAIT_S
    if write_limit "$CLAMP_VAL" exact; then
        log info "PRE-SLEEP CLAMP at ${cap}%: limit $cur -> $CLAMP_VAL; $(snap)"
    else
        rm -f "$SLEEP_FILE"   # a clamp that lands late still holds through the sleep; the daemon undoes it on resume (LATE CLAMP)
        log err "pre-sleep: the clamp did not show within ${SLEEP_APPLY_WAIT_S}s; sleeping unclamped; $(snap)"
    fi
    exit 0
fi
if [ "$mode" = postsleep ]; then
    # The sleep is over: end the daemon's hold on the clamp. With the daemon running it then applies its normal rules at its next
    # poll (releases when unplugged or at 77 % and below); without it, release here.
    rm -f "$SLEEP_FILE"
    if "$SYSTEMCTL" is-active --quiet gleipnir 2>/dev/null; then log info "post-sleep: daemon is running; it takes over; $(snap)"; exit 0; fi
    cur=$(num "$(rd "$LIM")")
    if is_clamped "$cur" && [ "$cur" != "$maxv" ]; then
        if ensure_released "$maxv"; then log warning "post-sleep: no daemon; released the sleep clamp, restored $maxv; $(snap)"
        else log err "post-sleep: no daemon and could NOT release the sleep clamp. Run: echo $maxv | sudo tee $LIM"; fi
    fi
    rm -f "$SLEEP_FILE"; exit 0
fi

if [ "$mode" = status ] && [ "$json" = 1 ]; then
    if marker_ok; then v=true; why=""; else v=false; why=$(printf '%s' "$MARKER_WHY" | tr -d '"\\'); fi
    fmt='{"node":"%s","kind":"%s","clamp_value":%s,"node_max":%s,"verified":%s,"verified_why":"%s","kernel":"%s",'
    fmt+='"capacity":%s,"status":"%s","usb_online":%s,"current_ua":%s,"voltage_uv":%s,"temp_dc":%s,"health":"%s","limit":%s,"sleep_floor":%s,"sleep_mode":"%s"}\n'
    printf "$fmt" "$LIM" "$KIND" "$CLAMP_VAL" "$maxv" "$v" "$why" "$KERNEL" \
        "$(num "$(rd "$B/capacity")")" "$(rd "$B/status")" "$(num "$(rd "$U/online")")" "$(num "$(rd "$B/current_now")")" \
        "$(num "$(rd "$B/voltage_now")")" "$(num "$(rd "$B/temp")")" "$(rd "$B/health")" "$(num "$(rd "$LIM")")" "$(sleep_floor)" "$(sleep_mode)"
    exit 0
fi
if [ "$mode" = status ]; then
    echo "node:      $LIM  ($KIND)"
    echo "clamp:     writes $CLAMP_VAL; node maximum $maxv"
    if marker_ok; then echo "verified:  yes ($(tr '\n' ' ' < "$MARKER"))"; else echo "verified:  NO - $MARKER_WHY"; fi
    echo "battery:   $(snap)"
    command -v journalctl >/dev/null 2>&1 && { echo "journal:"; journalctl -t gleipnir -n 5 --no-pager 2>/dev/null | sed 's/^/  /'; }
    exit 0
fi

if [ "$mode" = test ]; then
    CLAMP_S="${GLEIPNIR_CLAMP_S:-180}"; BASE_S="${GLEIPNIR_BASE_S:-6}"; AFTER_S="${GLEIPNIR_AFTER_S:-120}"; SAMPLE_S="${GLEIPNIR_SAMPLE_S:-2}"
    echo "==> Limit node: $LIM ($KIND); found value: $(rd "$LIM"); would write: $CLAMP_VAL; kernel: $KERNEL"
    echo "==> Plan: sample ${BASE_S}s, write the clamp and wait up to ${CLAMP_S}s for charging to stop (it took about a minute on the Thor), put the found value back and make sure it stays back (${HOLD_S}s), then wait up to ${AFTER_S}s for charging to resume. PASS needs: charging stops (or falls under a quarter of the baseline) while clamped AND resumes after the release."
    echo "==> Safety: the found value is restored on any exit; aborts and restores if the charger is unplugged, the battery passes 45 C, or the level drops 2 points."
    if [ "$run" != 1 ]; then echo "Plan only; nothing was written. Add --run (as root, charger plugged in, battery 10-90 %)."; exit 0; fi
    if [ "$(id -u)" != 0 ] && [ "${GLEIPNIR_ALLOW_NONROOT:-0}" != 1 ]; then echo "Run as root: sudo $0 --test --run" >&2; exit 4; fi
    st=$(rd "$B/status"); cap0=$(num "$(rd "$B/capacity")"); usb=$(num "$(rd "$U/online")")
    if [ "$st" != Charging ] || [ "$usb" != 1 ]; then
        echo "Refusing: status is '$st' (usb online $usb). Plug the charger in and wait for 'Charging'." >&2
        echo "Supplies seen: $(for d in "$PS"/*; do printf '%s=%s ' "$(basename "$d")" "$(rd "$d/online")"; done)" >&2
        exit 4
    fi
    { [ "$cap0" -ge 10 ] && [ "$cap0" -le 90 ]; } || { echo "Refusing: battery is at ${cap0}%. Test between 10 and 90 % so charging is not tapering already." >&2; exit 4; }
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet gleipnir.service 2>/dev/null; then
        echo "Refusing: gleipnir.service is running and could clamp during the test. Stop it first: sudo systemctl stop gleipnir (the Decky panel does this for you)." >&2
        exit 4
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null
    TESTLOG="$STATE_DIR/test-$(date +%Y%m%d-%H%M%S).log"
    exec > >(tee -a "$TESTLOG") 2>&1
    echo "==> Logging this run to $TESTLOG and the journal"
    orig=$(num "$(rd "$LIM")")
    if is_clamped "$orig"; then echo "Refusing: the limit already reads $orig (clamped). Run --restore first." >&2; exit 4; fi
    tlog() { log info "test: $*"; }
    sample() { printf '   %-8s %s\n' "$1" "$(snap)"; }
    avgcur() { local t=0 s=0 n=0 x; while [ "$t" -lt "$1" ]; do x=$(abs "$(rd "$B/current_now")"); s=$((s + x)); n=$((n + 1)); sample "$2"; sleep "$SAMPLE_S"; t=$((t + SAMPLE_S)); done; echo $((n > 0 ? s / n : 0)) > "$STATE_DIR/.avg"; }
    restored=0; touched=0
    restore_test() {
        [ "$restored" = 1 ] && return; restored=1
        [ "$touched" = 1 ] || return 0      # never wrote the clamp, nothing to put back
        if ensure_released "$orig" || ensure_released "$maxv"; then
            echo "==> Restored the limit: node reads $(rd "$LIM") (found $orig)"; tlog "restored limit, node reads $(rd "$LIM")"
        else
            echo "!!! COULD NOT RESTORE. Run: echo $maxv | sudo tee $LIM" >&2; log err "test could not restore the limit; run: echo $maxv | sudo tee $LIM"
        fi
    }
    trap restore_test EXIT INT TERM
    tlog "start $(snap)"
    echo "-- baseline"; avgcur "$BASE_S" before; base=$(cat "$STATE_DIR/.avg")
    if [ "$base" -lt 300000 ]; then echo "Refusing: charging current is only ${base} uA, too low for a meaningful test. Retry with the Thor idle and the battery lower." >&2; exit 4; fi
    echo "-- clamp: writing $CLAMP_VAL"; tlog "clamping to $CLAMP_VAL (baseline ${base}uA)"
    touched=1
    node_write "$CLAMP_VAL" || { echo "FAIL: the kernel refused the write." >&2; rm -f "$MARKER"; exit 5; }   # the node shows it late: judge by the charging current below
    effective=0; abort=""; eff_streak=0; t=0
    while [ "$t" -lt "$CLAMP_S" ]; do
        sample clamped
        st=$(rd "$B/status"); i=$(abs "$(rd "$B/current_now")"); cap=$(num "$(rd "$B/capacity")"); tmp=$(num "$(rd "$B/temp")"); usb=$(num "$(rd "$U/online")")
        [ "$usb" = 1 ] || { abort="charger was unplugged"; break; }
        [ "$tmp" -lt 450 ] || { abort="battery reached ${tmp} (0.1 C)"; break; }
        [ "$cap" -gt $((cap0 - 2)) ] || { abort="battery level fell from $cap0 to $cap"; break; }
        if [ "$st" != Charging ] || [ "$i" -lt $((base / 4)) ]; then eff_streak=$((eff_streak + 1)); else eff_streak=0; fi
        [ "$eff_streak" -ge 3 ] && { effective=1; break; }
        sleep "$SAMPLE_S"; t=$((t + SAMPLE_S))
    done
    echo "-- restore"; restore_test
    if [ -n "$abort" ]; then echo "ABORTED: $abort. Nothing was verified." >&2; tlog "aborted: $abort"; rm -f "$MARKER"; exit 5; fi
    echo "-- waiting for charging to resume (up to ${AFTER_S}s)"
    resumed=0; streak=0; t=0
    while [ "$t" -lt "$AFTER_S" ]; do
        sample after
        st=$(rd "$B/status"); i=$(abs "$(rd "$B/current_now")")
        if [ "$st" = Charging ] && [ "$i" -ge $((base / 4)) ]; then streak=$((streak + 1)); else streak=0; fi
        [ "$streak" -ge 2 ] && { resumed=1; break; }
        [ "$(num "$(rd "$U/online")")" = 1 ] || break      # unplugged: charging cannot resume, stop waiting
        sleep "$SAMPLE_S"; t=$((t + SAMPLE_S))
    done
    back=$(num "$(rd "$LIM")"); released_ok=0; is_clamped "$back" || released_ok=1
    echo; echo "================ RESULT ================"
    echo "baseline ${base} uA | limit took effect: $([ "$effective" = 1 ] && echo yes || echo NO) | charging resumed after release: $([ "$resumed" = 1 ] && echo yes || echo NO) | node released: $([ "$released_ok" = 1 ] && echo yes || echo NO)"
    if [ "$effective" = 1 ] && [ "$resumed" = 1 ] && [ "$released_ok" = 1 ]; then
        printf 'node=%s\nvalue=%s\nkernel=%s\nverified_at=%s\nbaseline_uA=%s\n' "$LIM" "$CLAMP_VAL" "$KERNEL" "$(date -Is)" "$base" > "$MARKER"
        tlog "PASS; marker written for $LIM value $CLAMP_VAL kernel $KERNEL"
        echo "PASS. Marker written: $MARKER"; echo "The daemon arms itself within one poll (30 s) if it is running; otherwise: sudo systemctl enable --now gleipnir"
        exit 0
    fi
    rm -f "$MARKER"; tlog "FAIL; no marker"
    echo "FAIL. No marker written; the daemon stays monitor-only. Do NOT rely on this limit." >&2; exit 5
fi

# --- the daemon ------------------------------------------------------------------------------------------------
for _ in $(seq 1 "${GLEIPNIR_WAIT_S:-30}"); do
    [ -e "$B/capacity" ] && [ -e "$U/online" ] && break
    sleep 1
done

rm -f "$SLEEP_FILE"   # a new daemon run cannot be in the middle of a sleep it knows about
state=released; saved=""; clamped_at=0; last_change=-$MIN_HOLD_S; bad=0; armed=-1; last_beat=0
idle_polls=0; last_idle_warn=-600

release() {   # release WHY ; safe direction, never rate-limited
    [ "$state" = clamped ] || return 0
    local target="${saved:-$maxv}"; is_clamped "$target" && target=$maxv
    if ensure_released "$target"; then
        log info "RELEASE ($1): restored $target; $(snap)"
    elif ensure_released "$maxv"; then
        log warning "RELEASE ($1): could not put $target back, restored the node maximum $maxv; $(snap)"
    else
        log err "COULD NOT RELEASE the limit ($1). Run: echo $maxv | sudo tee $LIM"; return 1
    fi
    state=released; saved=""; last_change=$SECONDS; return 0
}
clamp() {
    local c; c=$(num "$(rd "$LIM")")
    is_clamped "$c" || saved=$c
    # Record the clamp BEFORE writing it: a TERM that arrives between the write and the bookkeeping must still release it
    state=clamped; clamped_at=$SECONDS; last_change=$SECONDS
    if write_limit "$CLAMP_VAL" exact; then
        bad=0
        log info "CLAMP at ${cap}%: limit ${saved:-unknown} -> $CLAMP_VAL; $(snap)"
    else
        state=released; saved=""   # it never showed in time; a clamp that lands later is undone by the LATE CLAMP check in the loop
        last_change=$SECONDS
    fi
}
cleanup() { trap - EXIT; APPLY_WAIT_S=20; HOLD_S=5; release "daemon exiting"; }   # systemd waits 90 s for a stop; ExecStopPost --restore is the backstop
trap 'exit 0' TERM INT
trap cleanup EXIT

log info "started: node $LIM ($KIND), clamp value $CLAMP_VAL, kernel $KERNEL, target ${TARGET}%"
cur=$(num "$(rd "$LIM")")
if is_clamped "$cur" && [ "$cur" != "$maxv" ]; then state=clamped; saved=""; release "leftover clamp from an earlier run"; fi

while :; do
    cap=$(num "$(rd "$B/capacity")"); on=$(num "$(rd "$U/online")"); st=$(rd "$B/status"); cur_i=$(abs "$(rd "$B/current_now")"); cur_s=$(num "$(rd "$B/current_now")")
    # Monitoring: nothing is clamped, a charger is attached and the battery is clearly below the cap, yet it is not charging.
    # Seen on the Thor on 2026-10-08: after a clamp held for about 90 s at 80 % was released, the status stayed 'Not charging'.
    if [ "$state" = released ] && [ "$on" = 1 ] && [ "$cap" -lt "$RELEASE_AT" ] && [ "$st" != Charging ]; then
        idle_polls=$((idle_polls + 1))
        if [ "$idle_polls" -ge 5 ] && [ $((SECONDS - last_idle_warn)) -ge 600 ]; then
            log warning "NOT CHARGING with the limit released: ${cap}% (below the ${RELEASE_AT}% release point), charger online, status '$st'. Unplugging and replugging the charger may be needed. $(snap)"
            last_idle_warn=$SECONDS
        fi
    else
        idle_polls=0
    fi
    lim_now=$(num "$(rd "$LIM")")
    if [ "$state" = released ] && [ -r "$SLEEP_FILE" ]; then   # a clamp from --pre-sleep: take it over (a stale file is dropped)
        f_at=$(num "$(sed -n 's/^at=//p' "$SLEEP_FILE" | head -1)")
        if is_clamped "$lim_now" && [ "$lim_now" != "$maxv" ]; then
            saved=$(num "$(sed -n 's/^saved=//p' "$SLEEP_FILE" | head -1)"); is_clamped "$saved" && saved=""
            state=clamped; clamped_at=$SECONDS; last_change=$SECONDS; bad=0   # the file stays: it makes the daemon HOLD until --post-sleep
            log info "ADOPT: the limit reads $lim_now from the pre-sleep clamp; holding it until the sleep is over; $(snap)"
        elif [ $(( $(date +%s) - f_at )) -gt 300 ]; then rm -f "$SLEEP_FILE"; fi
    fi
    if [ "$state" = released ] && is_clamped "$lim_now" && [ "$lim_now" != "$maxv" ]; then
        log warning "LATE CLAMP: the limit reads $lim_now but this daemon holds no clamp (a write from an earlier test or run that took effect late); writing $maxv back. $(snap)"
        node_write "$maxv" || log err "could not write $maxv to $LIM"
    fi
    if marker_ok; then now_armed=1; else now_armed=0; fi
    if [ "$now_armed" != "$armed" ]; then
        if [ "$now_armed" = 1 ]; then log info "ARMED: verified on this kernel ($(tr '\n' ' ' < "$MARKER"))"; else log warning "MONITOR-ONLY: $MARKER_WHY"; fi
        armed=$now_armed
    fi

    if [ "$armed" = 1 ]; then
        if [ "$state" = released ]; then
            if [ "$on" = 1 ] && [ "$cap" -ge "$TARGET" ] && [ $((SECONDS - last_change)) -ge "$MIN_HOLD_S" ]; then clamp; fi
        else
            sleep_hold=0
            if [ -r "$SLEEP_FILE" ]; then
                f_at=$(num "$(sed -n 's/^at=//p' "$SLEEP_FILE" | head -1)")
                [ $(( $(date +%s) - f_at )) -le 3600 ] && sleep_hold=1   # an hour at most, in case --post-sleep never runs
            fi
            if [ "$sleep_hold" = 1 ]; then :   # a clamp placed for a sleep: the 77 % and unplug rules wait until --post-sleep removes the file
            elif [ "$on" != 1 ]; then release "charger unplugged"
            elif [ "$cap" -le "$RELEASE_AT" ]; then release "battery down to ${cap}%"
            elif [ $((SECONDS - clamped_at)) -ge "$SETTLE_S" ]; then
                # current_now is positive while charging and negative while discharging; the status says Charging in both cases (seen 2026-10-08
                # under a game load with a weak charger), so only a positive current counts as charging.
                if [ "$st" = Charging ] && [ "$cur_s" -gt "$WATCH_UA" ]; then bad=$((bad + 1)); else bad=0; fi
                if [ "$bad" -ge "$BAD_LIMIT" ]; then
                    log err "WATCHDOG: still charging at ${cur_s}uA ${SETTLE_S}s after the clamp; the limit has no effect on this Thor. Releasing, deleting the marker, exiting. $(snap)"
                    release "limit ineffective"; rm -f "$MARKER"; exit 78
                fi
            fi
        fi
    elif [ "$state" = clamped ]; then
        release "verification no longer valid"
    fi
    if [ "$FAILS" -ge 3 ]; then
        log err "three failed limit writes in a row; releasing and stopping. $(snap)"
        release "repeated write failures"; exit 78
    fi

    if [ $((SECONDS - last_beat)) -ge "$HEARTBEAT_S" ]; then
        log info "heartbeat: armed=$armed state=$state; $(snap)"; last_beat=$SECONDS
    fi
    sleep "$POLL_S" & wait $!
done
